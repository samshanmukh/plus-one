# Required
ANTHROPIC_API_KEY=sk-ant-...
INKBOX_API_KEY=...            # identity-scoped key for the Bluetail identity

# Optional
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-opus-5-5
HOME_LAT=37.7749
HOME_LON=-122.4194
HOME_TZ=America/Los_Angeles
# Calendars (names in macOS Calendar.app) checked for conflicts; first one gets new events
CALENDARS=you@gmail.com,Work,Home
OWNER_NAME=Sam
# Only these numbers may talk to the agent (comma-separated E.164). Empty = anyone connected.
ALLOWED_NUMBERS=
POLL_SECONDS=3
# SingleStore (optional). Unset = local SQLite file.
# From your Helios workspace's Connect > Python: user:password@host:3306/database
SINGLESTORE_URL=
# ...or fill these instead of the URL (from your cluster's Connect panel)
SINGLESTORE_HOST=
SINGLESTORE_USER=admin
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=plusone
